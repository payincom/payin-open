# ============================================================
# PayIn Admin Frontend - Multi-stage Dockerfile
# ============================================================

# ============================
# Stage 1: Builder
# ============================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/admin/package*.json ./apps/admin/

# Install ALL dependencies (including devDependencies for build)
RUN npm install

# Copy source code
COPY tsconfig.json ./
COPY packages/shared/ ./packages/shared/
COPY apps/admin/ ./apps/admin/

# Build arguments for environment variables (injected at build time)
ARG VITE_API_URL
ARG VITE_PAYMENT_LINK_PUBLIC_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

# Build shared package first (admin depends on it)
RUN echo "Building shared package..." && \
    npx tsc --build packages/shared --force && \
    echo "Shared package built!"

# Build the admin application
RUN cd apps/admin && \
    echo "Building admin frontend..." && \
    npm run build && \
    echo "Build complete!" && \
    ls -la dist/

# ============================
# Stage 2: Production (nginx)
# ============================
FROM nginx:alpine

# Copy built files from builder stage
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html

# Create nginx config with placeholder for PORT
RUN echo 'server { \
    listen __PORT__; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /assets/ { \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript; \
}' > /etc/nginx/conf.d/default.conf

# Start nginx with dynamic PORT substitution
CMD ["/bin/sh", "-c", "sed -i \"s/__PORT__/${PORT:-80}/g\" /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
