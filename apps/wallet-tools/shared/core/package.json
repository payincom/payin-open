{
  "name": "@payin/wallet-core",
  "version": "1.0.0",
  "description": "Core wallet logic for PayIn wallet tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./wallet": "./dist/wallet.js",
    "./types": "./dist/types.js",
    "./config": "./dist/config.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/wallet.ts src/types.ts src/config.ts --format esm --dts",
    "dev": "tsup src/index.ts src/wallet.ts src/types.ts src/config.ts --format esm --dts --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.15.0",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
