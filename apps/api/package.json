{
  "name": "@payin/app",
  "version": "0.1.0",
  "type": "module",
  "description": "PayIn Web Server with API and UI for managing payment operations",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:shared\" --names \"server,vite,shared\" --prefix-colors \"blue,green,yellow\"",
    "dev:server": "NODE_ENV=development tsx watch src/index.ts",
    "dev:client": "vite build --watch --mode development",
    "dev:shared": "cd ../../packages/shared && tsc --watch --preserveWatchOutput",
    "dev:server-only": "NODE_ENV=development tsx watch src/index.ts",
    "build": "npm run build:client && tsc --build --force",
    "build:client": "vite build",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest",
    "extract-classes": "node extract-template-classes.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@payin/auth": "file:../../packages/auth",
    "@payin/manager": "file:../../packages/manager",
    "@payin/processor": "file:../../packages/processor",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@tanstack/react-query": "^5.90.6",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "hono": "^4.10.4",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "viem": "^2.38.6",
    "wagmi": "^2.19.2",
    "yaml": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^20.19.24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^1.2.0"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./runtime-contract": {
      "types": "./dist/runtime-contract.d.ts",
      "import": "./dist/runtime-contract.js"
    },
    "./package.json": "./package.json"
  }
}
