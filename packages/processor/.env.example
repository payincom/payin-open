# Processor Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ============================================================================
# DATABASE CONFIGURATION (Sensitive Information)
# ============================================================================
# These are the ONLY environment variables still supported by Processor
# All other configuration should be done via YAML files or constructor parameters

# Option 1: Use full connection string (recommended)
DATABASE_URL=postgresql://user:password@host:port/database

# Or use Processor-specific variable
# PROCESSOR_DB_URL=postgresql://user:password@host:port/database

# Option 2: Use individual connection parameters
# PROCESSOR_DB_HOST=localhost
# PROCESSOR_DB_PORT=5432
# PROCESSOR_DB_NAME=payin
# PROCESSOR_DB_USER=postgres
# PROCESSOR_DB_PASSWORD=your_password
# PROCESSOR_DB_MAX_CONNECTIONS=10
# PROCESSOR_DB_SSL=false

# ============================================================================
# RPC PROVIDER API KEYS - NO LONGER SUPPORTED VIA ENVIRONMENT VARIABLES
# ============================================================================
# RPC keys should now be passed via constructor parameters:
#
# const processor = await Processor.create({
#   monitor: {
#     rpcKeys: {
#       alchemy: 'your_key',
#       infura: 'your_key',
#       trongrid: 'your_key'
#     }
#   }
# });
#
# Or configured in YAML files (for non-sensitive configuration)

# ============================================================================
# CONFIGURATION FILES - NO LONGER SUPPORTED VIA ENVIRONMENT VARIABLES
# ============================================================================
# Custom config files should now be passed via constructor:
#
# const processor = await Processor.create(
#   { /* config */ },
#   '/path/to/custom.yaml'  // configFile parameter
# );
#
# NODE_ENV is no longer used for environment-specific config files

# ============================================================================
# TESTING
# ============================================================================

# Skip database initialization in tests
# SKIP_INIT_DB=false

# NOTE: Test mnemonic is hardcoded in test-utils.ts (only contains testnet funds)
# You don't need to set MNEMONIC environment variable for tests
