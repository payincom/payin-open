{
  "name": "@payin/auth",
  "version": "0.1.0",
  "description": "Authentication and authorization module for PayIn",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
