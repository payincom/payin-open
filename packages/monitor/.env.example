# Monitor Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ============================================================================
# RPC PROVIDER API KEYS - NO LONGER SUPPORTED VIA ENVIRONMENT VARIABLES
# ============================================================================
# RPC keys should now be passed via:
#
# 1. Constructor parameters (recommended for sensitive data):
#
#   import { loadMonitorConfig } from '@payin/monitor';
#
#   const config = await loadMonitorConfig(
#     undefined,  // optional custom yaml path
#     {
#       rpc: {
#         apiKeys: {
#           alchemy: process.env.ALCHEMY_KEY,
#           infura: process.env.INFURA_KEY,
#           trongrid: process.env.TRONGRID_KEY
#         }
#       }
#     }
#   );
#
# 2. YAML configuration files (for non-sensitive config):
#
#   See config/default.yaml for provider templates
#   Pass custom yaml path as first parameter to loadMonitorConfig()

# ============================================================================
# CONFIGURATION FILES - NO LONGER SUPPORTED VIA ENVIRONMENT VARIABLES
# ============================================================================
# MONITOR_CONFIG_FILE is no longer supported
# Pass custom config file path directly to loadMonitorConfig():
#
#   const config = await loadMonitorConfig('/path/to/custom.yaml');

# ============================================================================
# NOTES
# ============================================================================
# - Monitor no longer reads RPC_*_KEY environment variables
# - Monitor no longer reads MONITOR_* configuration variables
# - All configuration should be done via YAML files or constructor parameters
# - Only sensitive data (like API keys) should come from environment variables
#   and should be explicitly passed via constructor parameters
