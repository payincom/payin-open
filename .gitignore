# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (contain sensitive information)
.env
.env.local
.env.development
.env.test
.env.production
.env.docker

# Keep example files
!.env.example

# Custom configuration files (may contain sensitive data)
**/config/custom.yaml
**/config/local.yaml

# Build output
dist/
build/
coverage/
packages/*/dist/
apps/*/dist/

# TypeScript build info
*.tsbuildinfo

# Logs
logs/
*.log
test-output.log
dual-business-recovery.test.log
postgresql-test.log
test_run_*.log

# Temporary files
tmp/
temp/
.tmp/
.cache/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Database files
*.db
*.sqlite
*.sqlite3
:memory:/

# Docker
.dockerignore

# Backup files
*.backup
*.bak

# Test artifacts
coverage/
.nyc_output/

# Package manager files
# PayIn Open intentionally does not track generated package-manager lockfiles.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Cloudflare Wrangler
.wrangler/

# Private files (if needed)
.private/
.secret/

# Test compiled files
app/tests/*.js
app/tests/*.d.ts
!app/tests/*.config.js

# AI assistant / local agent configuration (do not publish)
AGENTS.md
CLAUDE.md
GEMINI.md
.gemini/
.claude/
.cursor/
.codex/
.openclaw/

# Local sync/one-off scripts
sync.sh
test-*.sh
.rcloneignore
