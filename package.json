{
  "name": "payin-open",
  "version": "0.1.0-local",
  "description": "Open-source, secure, user-friendly stablecoin payment system",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run watch:monitor\" \"npm run watch:processor\" \"npm run dev -w apps/api\" --names \"mon,proc,api\" --prefix-colors \"magenta,cyan,blue\"",
    "dev:api": "npm run watch:monitor & npm run watch:processor & npm run dev -w apps/api",
    "watch:monitor": "npm run dev -w packages/monitor",
    "watch:processor": "npm run dev -w packages/processor",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build:shared && npm run build:monitor && npm run build:processor && npm run build:email && npm run build:notification && npm run build:test-utils && npm run build:auth && npm run build:manager",
    "build:apps": "npm run build -w apps/api",
    "build:shared": "npm run build -w packages/shared",
    "build:monitor": "npm run build -w packages/monitor",
    "build:processor": "npm run build -w packages/processor",
    "build:email": "npm run build -w packages/email",
    "build:notification": "npm run build -w packages/notification",
    "build:test-utils": "npm run build -w packages/test-utils",
    "build:auth": "npm run build -w packages/auth",
    "build:manager": "npm run build -w packages/manager",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --build --pretty false packages/shared packages/monitor packages/processor packages/notification packages/email packages/manager packages/auth packages/test-utils apps/api",
    "clean": "rm -rf dist node_modules/.cache",
    "postinstall": "[ -z \"$CI\" ] && [ -z \"$RAILWAY_ENVIRONMENT\" ] && husky install || true",
    "db:init": "tsx scripts/init-database.ts",
    "db:init:demo": "tsx scripts/init-database.ts --demo-data",
    "db:init:force": "tsx scripts/init-database.ts --force",
    "db:init:full": "tsx scripts/init-database.ts --demo-data --force",
    "open:init": "tsx scripts/open/open-init.ts",
    "open:doctor": "tsx scripts/open/open-doctor.ts",
    "open:smoke": "tsx scripts/open/open-smoke.ts",
    "test:integration": "vitest run packages/manager/tests/integration/ packages/auth/tests/integration/",
    "test:integration:manager": "vitest run packages/manager/tests/integration/manager-processor-integration.test.ts",
    "test:integration:auth": "vitest run packages/auth/tests/integration/auth-initialize.test.ts",
    "deploy:build": "./scripts/deployment/build-for-railway.sh",
    "deploy:railway:test": "./scripts/deployment/deploy-to-railway.sh test",
    "deploy:railway:prod": "./scripts/deployment/deploy-to-railway.sh production",
    "test:unit": "vitest run packages/notification/tests packages/email/tests packages/monitor/tests/rpc-config.test.ts packages/processor/tests/unit/open-processor-facade.test.ts packages/processor/tests/unit/transfer-repository-scope.test.ts packages/manager/tests/unit/open-manager.test.ts apps/api/tests/url-generation.test.ts apps/api/tests/api-url-fields.test.ts apps/api/tests/open-runtime.test.ts tests/open-ops.test.ts tests/open-smoke-live.test.ts",
    "boundary:check": "node scripts/quality/check-open-boundary.cjs",
    "open:verify": "npm run boundary:check && npm run open:doctor && npm run open:init -- --check && npm run open:smoke && npm run type-check && npm run build && npm run test:unit && npm run build -w apps/docs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.4",
    "@prisma/client": "^6.18.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bcrypt": "^5.1.1",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.15.0",
    "hono": "^4.10.4",
    "https-proxy-agent": "^7.0.6",
    "pg": "^8.16.3",
    "tronweb": "^6.0.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.19.24",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/coverage-v8": "^1.6.1",
    "commander": "^14.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vitest": "^0.3.26",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "nodemailer": "^7.0.10",
    "prettier": "^3.6.2",
    "prisma": "^6.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.0.0",
  "keywords": [
    "stablecoin",
    "payment",
    "blockchain",
    "typescript",
    "hono"
  ],
  "author": "PayIn Development Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payincom/payin-open.git"
  },
  "bugs": {
    "url": "https://github.com/payincom/payin-open/issues"
  },
  "homepage": "https://github.com/payincom/payin-open#readme"
}
