# ============================================================
# PayIn Environment Variables Template
# ============================================================
# Copy this file to .env.development or .env.production
# and fill in the actual values
#
# DO NOT commit .env.development or .env.production to Git
# ============================================================

# ===== Node Environment =====
NODE_ENV=development

# ===== Server Configuration =====
PORT=3000
HOST=0.0.0.0

# ===== Database Configuration (Supabase PostgreSQL) =====
# Use pooler connection for better performance: aws-1-ap-southeast-1.pooler.supabase.com
DB_CONNECTION_STRING=postgresql://user:password@host:5432/database

# ===== Blockchain RPC API Keys =====

# Alchemy (Ethereum, Polygon)
# Get your key from: https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Infura (Ethereum, Polygon)
# Get your key from: https://infura.io/
INFURA_API_KEY=your_infura_api_key_here

# TronGrid (Tron)
# Get your key from: https://www.trongrid.io/
TRONGRID_API_KEY=your_trongrid_api_key_here

# Ankr (Multi-chain)
# Get your key from: https://www.ankr.com/
ANKR_API_KEY=your_ankr_api_key_here

# Tatum (Solana)
# Get your key from: https://tatum.io/
TATUM_API_KEY=your_tatum_api_key_here

# Helius (Solana)
# Get your key from: https://helius.dev/
HELIUS_API_KEY=your_helius_api_key_here

# QuickNode (Production - Optional)
# Get your key from: https://www.quicknode.com/
QUICKNODE_API_KEY=your_quicknode_api_key_here

# QuickNode Solana Devnet URL (Optional)
# Paste the full endpoint, e.g. https://example.solana-devnet.quiknode.pro/abcd1234/
QUICKNODE_SOLANA_DEVNET_URL=

# ===== Authentication & Security =====

# JWT Secret (use a strong random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production-minimum-32-chars

# ===== Email Service (Brevo SMTP) =====

# Brevo SMTP User
BREVO_SMTP_USER=your-smtp-user@example.com

# Brevo SMTP Password
BREVO_SMTP_PASSWORD=your_brevo_smtp_password

# Brevo From Email
BREVO_FROM_EMAIL=noreply@payin.com

# ===== Supabase OAuth (Optional - for social login) =====

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key
SUPABASE_ANON_KEY=your_supabase_anon_key

# ===== Application Configuration =====

# Base URL (for email links and redirects)
# Development: http://localhost:3000
# Production: https://api.payin.com
BASE_URL=http://localhost:3000

# ===== Initialization Flags =====

# Initialize database on startup (true/false)
# Use 'true' for first-time setup, 'false' for production
INIT_DB=false

# Generate demo data on startup (true/false)
# Use 'true' for development, 'false' for production
DEMO_DATA=false

# ===== Logging =====

# Log level (debug/info/warn/error)
LOG_LEVEL=info

# ===== Optional: Monitor Configuration Overrides =====
# These can override values in manager.yaml if needed

# Scan interval in milliseconds (default: 5000 for dev, 15000 for prod)
# SCAN_INTERVAL=5000

# Block range size (default: 10)
# BLOCK_RANGE_SIZE=10

# Maximum concurrent scans (default: 5 for dev, 10 for prod)
# MAX_CONCURRENT_SCANS=5

# Safe block distance to avoid reorgs (default: 1 for dev, 3 for prod)
# SAFE_BLOCK_DISTANCE=1
